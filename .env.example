# Sao chép thành `.env` rồi sửa theo máy của bạn. `.env` không được đưa lên Git.
# Đường dẫn tương đối tính từ thư mục gốc repo. Trên Windows dùng dấu /.

# Bản Arrow của MINC-2500 Split 1 (tạo bởi `uv run minc download`)
DATASET_ROOT=./data/minc-2500

# Cache descriptor HOG, HSV, codebook (~3 GB) — nên đặt ở ổ còn trống nhiều
CACHE_ROOT=./cache

# Kết quả từng lần chạy: metadata, metrics, confusion matrix
RUNS_ROOT=./runs

# Không cần với dataset công khai; chỉ đặt khi bị rate-limit
# HF_TOKEN=
